    local rankMin = 254
    local friendCol = Color3.fromRGB(60, 210, 255)
    local normCol = Color3.fromRGB(170, 70, 255)
    local staffKeywords = {
        "admin",
        "staff",
        "moder",
        "owner",
        "founder",
        "creator",
        "developer",
        "dono",
        "fundador",
        "gerente",
        "supervis",
        "diretor",
        "gestor"
    }
    local function hasKeyword(s)
        s = string.lower(tostring(s or ""))
        for _, k in ipairs(staffKeywords) do
            if string.find(s, k, 1, true) then
                return true
            end
        end
        return false
    end
    local function isTruthy(v)
        local t = typeof(v)
        if t == "boolean" then
            return v
        end
        if t == "number" then
            return v > 0
        end
        if t == "string" then
            local s = string.lower(v)
            return s ~= "" and s ~= "false" and s ~= "0" and s ~= "none" and s ~= "guest" and s ~= "member"
        end
        return v ~= nil
    end
    local function isConfiguredStaff(plr)
        local list = C.KNWARE_SINTONIA_STAFF_USER_IDS
        if type(list) ~= "table" then
            return false
        end
        return list[plr.UserId] == true or list[tostring(plr.UserId)] == true or table.find(list, plr.UserId) ~= nil
    end
    local function isAdminRaw(plr)
        if isConfiguredStaff(plr) then
            return true, "configured"
        end
        if game.CreatorType == Enum.CreatorType.User and plr.UserId == game.CreatorId then
            return true, "creator"
        end
        local ok, attrs =
            pcall(
            function()
                return plr:GetAttributes()
            end
        )
        if ok then
            for k, v in pairs(attrs) do
                if hasKeyword(k) and isTruthy(v) then
                    return true, "attribute:" .. k
                end
            end
        end
        local ok2, tags = pcall(CollectionService.GetTags, CollectionService, plr)
        if ok2 then
            for _, tag in ipairs(tags) do
                if hasKeyword(tag) then
                    return true, "tag:" .. tag
                end
            end
        end
        return false, nil
    end
    local function getRel(plr)
        local r = o.relationships[plr]
        if r then
            return r
        end
        r = {ready = false, checking = false, friend = false, admin = false, rank = 0, role = "", source = nil}
        o.relationships[plr] = r
        return r
    end
    local function checkReady(plr)
        if plr == LocalPlayer or plr.Parent ~= Players then
            return
        end
        local rel = getRel(plr)
        if rel.checking then
            return
        end
        rel.checking = true
        task.spawn(
            function()
                local friend = false
                local ok, res =
                    pcall(
                    function()
                        return LocalPlayer:IsFriendsWith(plr.UserId)
                    end
                )
                if ok then
                    friend = res == true
                end
                local admin, src = isAdminRaw(plr)
                local rank, role = 0, ""
                if game.CreatorType == Enum.CreatorType.Group and game.CreatorId > 0 then
                    local ok2, r =
                        pcall(
                        function()
                            return plr:GetRankInGroup(game.CreatorId)
                        end
                    )
                    if ok2 and type(r) == "number" then
                        rank = r
                    end
                    local ok3, ro =
                        pcall(
                        function()
                            return plr:GetRoleInGroup(game.CreatorId)
                        end
                    )
                    if ok3 and type(ro) == "string" then
                        role = ro
                    end
                    if rank >= rankMin then
                        admin, src = true, "group-rank:" .. rank
                    elseif hasKeyword(role) then
                        admin, src = true, "group-role:" .. role
                    end
                end
                if plr.Parent == Players and o.relationships[plr] == rel then
                    rel.friend = friend
                    rel.admin = admin
                    rel.rank = rank
                    rel.role = role
                    rel.source = src
                    rel.ready = true
                    rel.checking = false
                end
            end
        )
    end
    local function getRelSafe(plr)
        local r = getRel(plr)
        if not r.ready and not r.checking then
            checkReady(plr)
        end
        return r
    end
    function Jz.Protected(plr)
        local r = getRelSafe(plr)
        if (T.friendCheck or T.adminCheck) and not r.ready then
            return true
        end
        if T.adminCheck and r.admin then
            return true
        end
        if T.friendCheck and r.friend then
            return true
        end
        return false
    end
    Jz.Admin = function(plr)
        local r = getRelSafe(plr)
        return r.ready and r.admin
    end
    Jz.Appearance = function(plr)
        local r = getRelSafe(plr)
        if r.ready and (T.adminCheck and r.admin) then
            return STAFF_RED, " [STAFF]"
        end
        if r.ready and (T.friendCheck and r.friend) then
            return friendCol, " [AMIGO]"
        end
        return normCol, ""
    end
    local function onAdded(plr)
        if plr == LocalPlayer then
            return
        end
        checkReady(plr)
        local conn =
            plr.AttributeChanged:Connect(
            function(name)
                if hasKeyword(name) then
                    local r = o.relationships[plr]
                    if r then
                        r.ready = false
                    end
                    checkReady(plr)
                end
            end
        )
        o.relationshipConnections[plr] = conn
        handleReady(conn)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        onAdded(plr)
    end
    handleReady(Players.PlayerAdded:Connect(onAdded))
    handleReady(
        Players.PlayerRemoving:Connect(
            function(plr)
                o.relationships[plr] = nil
                o.relationshipConnections[plr] = nil
            end
        )
    )
end

