local wz = {medido = false, drawing = false, texto = false}
function wz.set(obj, prop, val)
    return pcall(
        function()
            obj[prop] = val
        end
    )
end
function wz.medir()
    if wz.medido then
        return wz
    end
    if Drawing == nil or type(Drawing.new) ~= "function" then
        return wz
    end
    local ok, sq = pcall(Drawing.new, "Square")
    if not ok then
        return wz
    end
    wz.drawing = true
    wz.filled = wz.set(sq, "Filled", false)
    wz.thickness = wz.set(sq, "Thickness", 1)
    pcall(
        function()
            sq:Remove()
        end
    )
    local ok2, txt = pcall(Drawing.new, "Text")
    if ok2 then
        wz.texto = true
        wz.center = wz.set(txt, "Center", true)
        wz.outline = wz.set(txt, "Outline", true)
        wz.outlineColor = wz.set(txt, "OutlineColor", Color3.new())
        wz.font = wz.set(txt, "Font", 2)
        pcall(
            function()
                txt.Text = "MMM"
            end
        )
        local ok3, tb =
            pcall(
            function()
                return txt.TextBounds
            end
        )
        wz.textBounds = ok3 and (typeof(tb) == "Vector2" and tb.X > 0)
        pcall(
            function()
                txt:Remove()
            end
        )
    end
    local ok4, tr = pcall(Drawing.new, "Triangle")
    wz.triangle = ok4 == true
    if ok4 then
        pcall(
            function()
                tr:Remove()
            end
        )
    end
    wz.medido = true
    return wz
end
function wz.ok()
    return (wz.medir()).drawing
end

local function az(kind)
    if not wz.ok() then
        return nil
    end
    if kind == "Triangle" and not wz.triangle then
        return nil
    end
    local ok, obj =
        pcall(
        function()
            return Drawing.new(kind)
        end
    )
    if not ok then
        return nil
    end
    wz.set(obj, "Visible", false)
    wz.set(obj, "Color", Color3.fromRGB(170, 70, 255))
    wz.set(obj, "Transparency", 1)
    wz.set(obj, "Thickness", 1)
    return obj
end

local function iz(col)
    if not wz.ok() or not wz.texto then
        return nil
    end
    local ok, obj =
        pcall(
        function()
            return Drawing.new("Text")
        end
    )
    if not ok then
        return nil
    end
    wz.set(obj, "Visible", false)
    wz.set(obj, "Color", col or Color3.fromRGB(170, 70, 255))
    wz.set(obj, "Transparency", 1)
    wz.set(obj, "Size", 13)
    if wz.center then
        wz.set(obj, "Center", true)
    end
    if wz.outline then
        wz.set(obj, "Outline", true)
    end
    if wz.outlineColor then
        wz.set(obj, "OutlineColor", Color3.new(0, 0, 0))
    end
    if wz.font then
        wz.set(obj, "Font", 2)
    end
    return obj
end

local function larguraText(obj)
    if not obj then
        return 0
    end
    if wz.textBounds then
        local ok, tb =
            pcall(
            function()
                return obj.TextBounds
            end
        )
        if ok and tb then
            return tb.X
        end
    end
    local ok, txt =
        pcall(
        function()
            return obj.Text
        end
    )
    if not ok or type(txt) ~= "string" then
        return 0
    end
    local ok2, sz =
        pcall(
        function()
            return obj.Size
        end
    )
    return (#txt * (ok2 and sz or 13)) * 0.52
end

local dz = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
}
local Gz = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
}
local tz = #dz
local Kz = {{1, 2}, {1, 3}, {1, 5}, {2, 4}, {2, 6}, {3, 4}, {3, 7}, {4, 8}, {5, 6}, {5, 7}, {6, 8}, {7, 8}}
local CF, YF, gF, mF = 300, 0.016666, 0.033333, 0.05
local EF, MF = 4, 5
local HF = function(prev, now, interval)
    if prev <= 0 or now - prev > interval then
        return now + interval
    end
    return prev + interval
end

local function AF(plr)
    local b2 = {
        player = plr,
        box = az("Square"),
        name = iz(Color3.fromRGB(170, 70, 255)),
        distance = iz(Color3.fromRGB(190, 200, 225)),
        item = iz(Color3.fromRGB(190, 200, 225)),
        team = iz(Color3.fromRGB(170, 70, 255)),
        lines = {},
        tracer = nil,
        arrow = nil,
        box3dLines = {},
        highlight = nil,
        character = nil,
        humanoid = nil,
        root = nil,
        bodyParts = {},
        skeletonPairs = {},
        relationshipColor = nil,
        relationshipLabel = "",
        nextVisualUpdate = 0,
        nextSkeletonUpdate = 0
    }
    if b2.box and wz.filled then
        b2.box.Filled = false
    end
    for _ = 1, tz do
        table.insert(b2.lines, az("Line"))
    end
    T.bundles[plr] = b2
    return b2
end

local function FF(b2)
    if b2.box then
        b2.box.Visible = false
    end
    if b2.name then
        b2.name.Visible = false
    end
    if b2.distance then
        b2.distance.Visible = false
    end
    if b2.item then
        b2.item.Visible = false
    end
    if b2.team then
        b2.team.Visible = false
    end
    if b2.tracer then
        b2.tracer.Visible = false
    end
    if b2.arrow then
        b2.arrow.Visible = false
    end
    for _, l in ipairs(b2.lines) do
        l.Visible = false
    end
    for _, l in ipairs(b2.box3dLines) do
        l.Visible = false
    end
end

local function uF(b2)
    FF(b2)
    if b2.highlight then
        b2.highlight.Enabled = false
    end
end

local function qF(b2)
    if not b2 then
        return
    end
    local function h(obj)
        if obj then
            pcall(
                function()
                    obj:Remove()
                end
            )
        end
    end
    h(b2.box)
    h(b2.name)
    h(b2.distance)
    h(b2.item)
    h(b2.team)
    h(b2.tracer)
    h(b2.arrow)
    for _, l in ipairs(b2.lines) do
        h(l)
    end
    for _, l in ipairs(b2.box3dLines) do
        h(l)
    end
    if b2.highlight then
        pcall(
            function()
                b2.highlight:Destroy()
            end
        )
        b2.highlight = nil
    end
end

local function PF()
    for _, b2 in pairs(T.bundles) do
        uF(b2)
    end
end

local function zF(cam, pos)
    local s, onScreen = cam:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), onScreen, s.Z
end

local function oF(b2)
    if b2.tracer then
        return b2.tracer
    end
    b2.tracer = az("Line")
    if b2.tracer then
        if wz.thickness then
            b2.tracer.Thickness = 1.5
        end
        b2.tracer.Color = b2.relationshipColor or Color3.fromRGB(170, 70, 255)
    end
    return b2.tracer
end

local function TF(b2)
    if b2.arrow then
        return b2.arrow
    end
    b2.arrow = az("Triangle")
    if b2.arrow then
        if wz.filled then
            b2.arrow.Filled = true
        end
        if wz.thickness then
            b2.arrow.Thickness = 1
        end
        b2.arrow.Color = b2.relationshipColor or Color3.fromRGB(170, 70, 255)
    end
    return b2.arrow
end

local function fF(b2)
    if #b2.box3dLines > 0 then
        return b2.box3dLines
    end
    for _ = 1, #Kz do
        local l = az("Line")
        if l then
            if wz.thickness then
                l.Thickness = 1
            end
            l.Color = b2.relationshipColor or Color3.fromRGB(170, 70, 255)
            table.insert(b2.box3dLines, l)
        end
    end
    return b2.box3dLines
end

local function RF(b2, char)
    local hl = b2.highlight
    if not hl or not hl.Parent then
        local ok, newHl =
            pcall(
            function()
                local h = Instance.new("Highlight")
                h.Name = "KnwareESP_" .. tostring(b2.player.UserId)
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.78
                h.OutlineTransparency = 0
                h.Parent = workspace.CurrentCamera or workspace
                return h
            end
        )
        if not ok then
            return nil
        end
        hl = newHl
        b2.highlight = hl
    elseif hl.Parent ~= (workspace.CurrentCamera or workspace) then
        hl.Parent = workspace.CurrentCamera or workspace
    end
    local col = b2.relationshipColor or Color3.fromRGB(170, 70, 255)
    hl.Adornee = char
    hl.FillColor = col
    hl.OutlineColor = col
    return hl
end

local function QF(b2, cam, screenPos, z)
    local arrow = TF(b2)
    if not arrow then
        return
    end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
    local dir = screenPos - center
    if z <= 0 then
        dir = -dir
    end
    if dir.Magnitude < 0.001 then
        dir = Vector2.new(0, -1)
    end
    local unit = dir.Unit
    local radius = math.max(40, math.min(vp.X, vp.Y) * 0.42)
    local tip = center + unit * radius
    local back = tip - unit * 14
    local perp = Vector2.new(-unit.Y, unit.X) * 8
    arrow.PointA = tip
    arrow.PointB = back + perp
    arrow.PointC = back - perp
    arrow.Visible = true
end

local function VF(b2, char, hum, root)
    if b2.character == char and b2.humanoid == hum and b2.root == root then
        return
    end
    b2.character, b2.humanoid, b2.root = char, hum, root
    table.clear(b2.bodyParts)
    table.clear(b2.skeletonPairs)
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") then
            table.insert(b2.bodyParts, p)
        end
    end
    local pairsList = (hum.RigType == Enum.HumanoidRigType.R15) and dz or Gz
    for _, pr in ipairs(pairsList) do
        table.insert(b2.skeletonPairs, {char:FindFirstChild(pr[1]), char:FindFirstChild(pr[2])})
    end
end

local function pF(plr)
    local t = plr.Team
    local name = t and t.Name or nil
    if Jz.Admin(plr) and name ~= "STAFF" then
        return name and ("STAFF | " .. name) or "STAFF"
    end
    return name
end

local function IF(plr)
    local t = plr.Team
    local ok, col =
