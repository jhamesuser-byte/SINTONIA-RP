-- ============================================
-- GACHA 2%
-- ============================================
do
    local RS = game:GetService("ReplicatedStorage")
    local CHANCE_MINIMA = 0.02
    local MULTIPLICADOR = 3
    local ARMAS_RARAS = {
        Natalina = true,
        PtNinja = true,
        PtPaschoa = true,
        FuzilPaschoa = true,
        FuzilNinja = true,
        ArmaPDSecreta = true,
        Barret = true,
        FuzilTrovao = true,
        FuzilPhantom = true
    }
    local hooked = false
    local originalData = {}

    local function snapshot(t, seen)
        seen = seen or {}
        if seen[t] then
            return seen[t]
        end
        local copy = {}
        seen[t] = copy
        for k, v in pairs(t) do
            if type(v) == "table" then
                copy[k] = snapshot(v, seen)
            else
                copy[k] = v
            end
        end
        return copy
    end

    local function ehRara(nome)
        if not nome then
            return false
        end
        nome = tostring(nome)
        if ARMAS_RARAS[nome] then
            return true
        end
        local low = string.lower(nome)
        if
            string.find(low, "ninja") or string.find(low, "paschoa") or string.find(low, "secreta") or
                string.find(low, "trovao") or
                string.find(low, "phantom") or
                string.find(low, "barret") or
                string.find(low, "natalina")
         then
            return true
        end
        return false
    end

    local function reescreverChances(tbl, depth)
        depth = depth or 0
        if depth > 12 then
            return
        end
        for k, v in pairs(tbl) do
            if type(v) == "table" then
                local nome = v.Nome or v.nome or v.Name or v.name or k
                local eraRara = ehRara(nome)
                for _, field in ipairs(
                    {
                        "Chance",
                        "chance",
                        "Weight",
                        "weight",
                        "Probabilidade",
                        "probabilidade",
                        "Rate",
                        "rate",
                        "DropChance",
                        "dropChance"
                    }
                ) do
                    if type(v[field]) == "number" and v[field] > 0 then
                        if eraRara then
                            v[field] = CHANCE_MINIMA
                        else
                            if v[field] < CHANCE_MINIMA then
                                v[field] = CHANCE_MINIMA
                            else
                                v[field] = v[field] * MULTIPLICADOR
                            end
                        end
                    end
                end
                reescreverChances(v, depth + 1)
            end
        end
    end

    local function aplicarGacha()
        if IS_FREE then
            T.sorte2xEnabled = false
            return
        end
        if hooked then
            return
        end
        hooked = true
        local function scanMods(container, depth)
            if depth > 6 then
                return
            end
            for _, mod in ipairs(container:GetChildren()) do
                if mod:IsA("ModuleScript") then
                    local n = string.lower(mod.Name)
                    if
                        string.find(n, "gacha") or string.find(n, "roleta") or string.find(n, "sorteio") or
                            string.find(n, "spin") or
                            string.find(n, "crate") or
                            string.find(n, "caixa") or
                            string.find(n, "loot") or
                            string.find(n, "premi") or
                            string.find(n, "reward") or
                            string.find(n, "raridade")
                     then
                        local ok, data = pcall(require, mod)
                        if ok and type(data) == "table" then
                            if not originalData[mod] then
                                originalData[mod] = snapshot(data)
                            end
                            pcall(reescreverChances, data, 0)
                        end
                    end
                end
                scanMods(mod, depth + 1)
            end
        end
        scanMods(RS, 0)
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if ps then
            scanMods(ps, 0)
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            scanMods(pg, 0)
        end
        print("[VT GACHA] Chances forcadas para " .. (CHANCE_MINIMA * 100) .. "%")
    end

    local function restaurarGacha()
        for mod, snap in pairs(originalData) do
            pcall(
                function()
                    local ok, data = pcall(require, mod)
                    if ok and type(data) == "table" then
                        for k, v in pairs(snap) do
                            if type(v) == "table" then
                                data[k] = snapshot(v)
                            else
                                data[k] = v
                            end
                        end
                    end
                end
            )
        end
        originalData = {}
        hooked = false
    end

    o.aplicarGacha = aplicarGacha
    o.restaurarGacha = restaurarGacha

    task.spawn(
        function()
            task.wait(2)
            pcall(aplicarGacha)
        end
    )

    local ultimoEstado = false
    handleReady(
        RunService.Heartbeat:Connect(
            function()
                if o.destroyed then
                    return
                end
                if IS_FREE then
                    if T.sorte2xEnabled then
                        T.sorte2xEnabled = false
                    end
                    return
                end
                if T.sorte2xEnabled and not ultimoEstado then
                    pcall(aplicarGacha)
                elseif not T.sorte2xEnabled and ultimoEstado then
                    pcall(restaurarGacha)
                end
                ultimoEstado = T.sorte2xEnabled
            end
        )
    )
end

-- ============================================
-- AUTO FARM PESCA
-- ============================================
do
    local RS = game:GetService("ReplicatedStorage")
    local PESCA_TP = Vector3.new(-1165, -33, -5055)

    local function getCharacter()
        local character = LocalPlayer.Character
        if not character then
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local root = character:FindFirstChild("HumanoidRootPart")
        return character, humanoid, root
    end

    local function getTrashFolder()
        return workspace:FindFirstChild("Lixeiro")
    end

    local function collectTrashTargets()
        local _, humanoid, root = getCharacter()
        local trashFolder = getTrashFolder()
        if not humanoid or not root or humanoid.Health <= 0 or not trashFolder then
            return {}
        end
        local targets = {}
        for _, object in ipairs(trashFolder:GetChildren()) do
            if object:IsA("BasePart") and object.Name == "Lixo" then
                local prompt = object:FindFirstChildWhichIsA("ProximityPrompt")
                if prompt and prompt.Enabled then
                    targets[#targets + 1] = {
                        Part = object,
                        Prompt = prompt,
                        Distance = (root.Position - object.Position).Magnitude
                    }
                end
            end
        end
        table.sort(
            targets,
            function(a, b)
                return a.Distance < b.Distance
            end
        )
        return targets
    end

    local function walkTo(targetPosition, runId)
        local char, humanoid, root = getCharacter()
        if not char or not humanoid or not root then
            return false
        end
        local path =
            PathfindingService:CreatePath(
            {
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 5
            }
        )
        local ok =
            pcall(
            function()
                path:ComputeAsync(root.Position, targetPosition)
            end
        )
        local waypoints
        if ok and path.Status == Enum.PathStatus.Success then
            waypoints = path:GetWaypoints()
        else
            waypoints = {{Position = targetPosition, Action = Enum.PathWaypointAction.Walk}}
        end
        for _, waypoint in ipairs(waypoints) do
            if not isRun(runId) then
                return false
            end
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end
            humanoid:MoveTo(waypoint.Position)
            local reached = false
            local reachedConn =
                humanoid.MoveToFinished:Connect(
                function(finished)
                    reached = finished
                end
            )
            local deadline = os.clock() + 8
            repeat
                RunService.Heartbeat:Wait()
                if root and (root.Position - waypoint.Position).Magnitude <= 3 then
                    reached = true
                end
            until reached or os.clock() >= deadline or not isRun(runId)
            reachedConn:Disconnect()
            if not reached then
                return false
            end
        end
        return true
    end

    local function firePrompt(prompt)
        if not prompt or not prompt.Parent or not prompt.Enabled then
            return false
        end
        local ok =
            pcall(
            function()
                prompt:InputHoldBegin()
                task.wait(math.max(prompt.HoldDuration, 0.1))
                prompt:InputHoldEnd()
            end
        )
        return ok
    end

    local function getDeliveryPrompt()
        local deliveryFolder = workspace:FindFirstChild("EntregaLixo")
        local bin = deliveryFolder and deliveryFolder:FindFirstChild("Lixeira")
        if not bin then
            return
        end
        local prompt = bin:FindFirstChildWhichIsA("ProximityPrompt")
        return bin, prompt
    end

    local function destroyWorldParts()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "Terrain" then
                local isOwnCharacter = LocalPlayer.Character and v:IsDescendantOf(LocalPlayer.Character)
                local hasPrompt = v:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
                if not isOwnCharacter and not hasPrompt then
                    pcall(
                        function()
                            v:Destroy()
                        end
                    )
                end
            end
        end
    end

    local function isRun(runId)
        return T.autoFarmPescaEnabled and (not o.destroyed and o.pescaRunId == runId)
    end

    local function farmLoop(session)
        if IS_FREE then
            T.autoFarmPescaEnabled = false
            return
        end
        if T.autoFarmPescaEnabled and session == o.pescaRunId then
            destroyWorldParts()
        end
        while isRun(session) do
            local farmChar, hum, root = getCharacter()
            if root then
                root.CFrame = CFrame.new(PESCA_TP)
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local promptParent = prompt.Parent
                        if promptParent and promptParent:IsA("BasePart") then
                            local promptDistance = (promptParent.Position - root.Position).Magnitude
                            if promptDistance <= (prompt.MaxActivationDistance + 10) then
                                firePrompt(prompt)
                            end
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end

    local function setFarmEnabled(enabled)
        if IS_FREE then
            T.autoFarmPescaEnabled = false
            o.pescaRunId = o.pescaRunId + 1
            return
        end
        T.autoFarmPescaEnabled = enabled
        o.pescaRunId = o.pescaRunId + 1
        local session = o.pescaRunId
        if enabled then
            task.spawn(
                function()
                    pcall(farmLoop, session)
                end
            )
        end
    end

    o.startPesca = setFarmEnabled
end

