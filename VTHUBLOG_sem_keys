    local function vidaDoCarro(car)
        local body = car:FindFirstChild("Body")
        local paint = body and body:FindFirstChild("Pintura")
        local life = paint and paint:FindFirstChild("LifeController")
        return life and life:FindFirstChild("Vida")
    end
    o.vidaDoCarro = vidaDoCarro
    local function getMeuCarro()
        local hum = isCValid()
        local seat = hum and hum.SeatPart
        if not seat then
            return nil
        end
        local carros = workspace:FindFirstChild("CarrosSpawnados")
        if not carros then
            return nil
        end
        local p = seat
        while p and p.Parent do
            if p.Parent == carros then
                return p
            end
            p = p.Parent
        end
        return nil
    end
    local function desconectar()
        if S.vidaConn then
            S.vidaConn:Disconnect()
            S.vidaConn = nil
        end
        S.car = nil
        if S.painel then
            S.painel:SetVisible(false)
        end
    end
    local function conectar(car)
        local vida = vidaDoCarro(car)
        if not vida then
            return
        end
        if S.vidaConn then
            S.vidaConn:Disconnect()
        end
        S.car = car
        S.maxVida = math.max(MAX, vida.Value)
        if S.carLabel then
            S.carLabel.Text = car.Name
        end
        if S.painel then
            S.painel:SetVisible(true)
        end
        setVal(vida.Value)
        S.vidaConn =
            vida:GetPropertyChangedSignal("Value"):Connect(
            function()
                setVal(vida.Value)
            end
        )
    end
    function o.ativarDurabilidade()
        create()
        o.durabilidadeRunId = o.durabilidadeRunId + 1
        local runId = o.durabilidadeRunId
        task.spawn(
            function()
                while T.durabilidadeHudEnabled and (not o.destroyed and o.durabilidadeRunId == runId) do
                    local car = getMeuCarro()
                    if car ~= S.car then
                        if car and vidaDoCarro(car) then
                            pcall(conectar, car)
                        else
                            pcall(desconectar)
                        end
                    elseif car and not S.vidaConn then
                        pcall(conectar, car)
                    end
                    task.wait(0.3)
                end
            end
        )
    end
    function o.desativarDurabilidade()
        o.durabilidadeRunId = o.durabilidadeRunId + 1
        pcall(desconectar)
        if S.painel then
            S.painel:SetVisible(false)
        end
    end
    function o.destruirDurabilidade()
        pcall(desconectar)
        if S.gui then
            pcall(
                function()
                    S.gui:Destroy()
                end
            )
        end
        S.gui, S.frame, S.fill, S.painel = nil, nil, nil, nil
    end
end

-- ============================================
-- BEST CARS ESP
-- ============================================
do
    local INF = 1e+50
    local TOP = 10
    local INTERVAL = 0.1
    local H = {bundles = {}, catalogo = {}, proximaAtualizacao = 0}
    local function getVal(cfg)
        local c = cfg and cfg:FindFirstChild("Config")
        if not c then
            return nil
        end
        local v = c:FindFirstChild("Valor")
        return v and tonumber(v.Value) or 0
    end
    local function parseCar(model)
        local cfg = model and model:FindFirstChild("Config")
        if not cfg then
            return nil
        end
        return {nome = model.Name, valor = getVal(cfg)}
    end
    local function updateCatalogo()
        local rs = game:GetService("ReplicatedStorage")
        local orph = rs:FindFirstChild("OrpheusShared")
        local conc = orph and orph:FindFirstChild("Concessionaria")
        local vehicles = conc and conc:FindFirstChild("Veiculos")
        if not vehicles then
            H.catalogo = {}
            return
        end
        local list = {}
        for _, m in ipairs(vehicles:GetChildren()) do
            if m:IsA("Model") then
                local c = parseCar(m)
                if c and c.valor > 0 and c.valor < INF then
                    table.insert(list, c)
                end
            end
        end
        table.sort(
            list,
            function(a, b2)
                if a.valor == b2.valor then
                    return a.nome < b2.nome
                end
                return a.valor > b2.valor
            end
        )
        H.catalogo = {}
        for i = 1, math.min(TOP, #list), 1 do
            H.catalogo[list[i].nome] = list[i]
        end
    end
    local function getPrimary(car)
        return car.PrimaryPart or car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("BasePart", true)
    end
    local function fmtNum(n)
        return ((((tostring(math.floor(n + 0.5))):reverse()):gsub("(%d%d%d)", "%1.")):reverse()):gsub("^%.", "")
    end
    local function esc(s)
        return ((((tostring(s)):gsub("&", "&amp;")):gsub("<", "&lt;")):gsub(">", "&gt;")):gsub('"', "&quot;")
    end
    local function getDriver(car)
        local seat = car:FindFirstChild("DriveSeat", true) or car:FindFirstChildWhichIsA("VehicleSeat", true)
        local occ = seat and (seat:IsA("VehicleSeat") and seat.Occupant) or nil
        local plr = occ and Players:GetPlayerFromCharacter(occ.Parent) or nil
        return plr and plr.Name or "Desocupado", plr ~= nil
    end
    local function destroyBundle(car)
        local b2 = H.bundles[car]
        if not b2 then
            return
        end
        if b2.highlight then
            pcall(
                function()
                    b2.highlight:Destroy()
                end
            )
        end
        if b2.gui then
            pcall(
                function()
                    b2.gui:Destroy()
                end
            )
        end
        H.bundles[car] = nil
    end
    local function createBundle(car, part)
        local col = Color3.fromRGB(170, 70, 255)
        local hl = Instance.new("Highlight")
        hl.Name = "KnwareBestCarESP"
        hl.Adornee = car
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = col
        hl.OutlineColor = col
        hl.FillTransparency = 0.78
        hl.OutlineTransparency = 0
        hl.Parent = workspace.CurrentCamera or workspace
        local gui = Instance.new("BillboardGui")
        gui.Name = "KnwareBestCarLabel"
        gui.Adornee = part
        gui.AlwaysOnTop = true
        gui.LightInfluence = 0
        gui.MaxDistance = 10000
        gui.Size = UDim2.fromOffset(260, 84)
        gui.Parent = workspace.CurrentCamera or workspace
        local frame = Instance.new("Frame")
        frame.BackgroundColor3 = Color3.fromRGB(22, 14, 34)
        frame.BackgroundTransparency = 0.08
        frame.BorderSizePixel = 0
        frame.Size = UDim2.fromScale(1, 1)
        frame.Parent = gui
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 9)
        corner.Parent = frame
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(70, 45, 110)
        stroke.Transparency = 0.2
        stroke.Thickness = 1
        stroke.Parent = frame
        local txt = Instance.new("TextLabel")
        txt.BackgroundTransparency = 1
        txt.Position = UDim2.fromOffset(10, 7)
        txt.Size = UDim2.new(1, -20, 1, -14)
        txt.Font = Enum.Font.GothamBold
        txt.RichText = true
        txt.TextColor3 = Color3.fromRGB(240, 230, 255)
        txt.TextSize = 13
        txt.TextWrapped = true
        txt.TextXAlignment = Enum.TextXAlignment.Left
        txt.TextYAlignment = Enum.TextYAlignment.Center
        txt.Parent = frame
        local bundle = {highlight = hl, gui = gui, texto = txt, parte = part}
        H.bundles[car] = bundle
        return bundle
    end
    local function hideAll()
        for _, b2 in pairs(H.bundles) do
            if b2.highlight then
                b2.highlight.Enabled = false
            end
            if b2.gui then
                b2.gui.Enabled = false
            end
        end
    end
    local function tick()
        if not T.bestCarsEspEnabled then
            hideAll()
            return
        end
        if next(H.catalogo) == nil then
            updateCatalogo()
        end
        local cars = workspace:FindFirstChild("CarrosSpawnados")
        local root = isUpdatePlayerGetMagnitudeCValid()
        if not cars or not root then
            hideAll()
            return
        end
        local seen = {}
        for _, m in ipairs(cars:GetChildren()) do
            if m:IsA("Model") then
                local cat = H.catalogo[m.Name]
                local part = getPrimary(m)
                if part and cat then
                    seen[m] = true
                    local b2 = H.bundles[m] or createBundle(m, part)
                    b2.highlight.Enabled = true
                    b2.gui.Enabled = true
                    if b2.parte ~= part then
                        b2.parte = part
                        b2.gui.Adornee = part
                    end
                    local driver, occupied = getDriver(m)
                    local dCol = occupied and "#E85C54" or "#46BE78"
                    b2.texto.Text =
                        string.format(
                        'Ocupante: <font color="%s">%s</font>\nVeiculo: %s\nValor: $<font color="#46BE78">%s</font>\nDistancia: %.0fm',
                        dCol,
                        esc(driver),
                        esc(m.Name),
                        fmtNum(cat.valor),
                        (part.Position - root.Position).Magnitude
                    )
                else
                    destroyBundle(m)
                end
            end
        end
        for car in pairs(H.bundles) do
            if not seen[car] or not car.Parent then
                destroyBundle(car)
            end
        end
    end
    function o.ativarBestCarsEsp()
        updateCatalogo()
        H.proximaAtualizacao = 0
        pcall(tick)
    end
    function o.desativarBestCarsEsp()
        hideAll()
    end
    function o.destruirBestCarsEsp()
        for car in pairs(H.bundles) do
            destroyBundle(car)
        end
        H.catalogo = {}
    end
    handleReady(
        RunService.RenderStepped:Connect(
            function()
                local now = os.clock()
                if now < H.proximaAtualizacao then
                    return
                end
                H.proximaAtualizacao = now + INTERVAL
                pcall(tick)
            end
        )
    )
end

-- ============================================
-- AUTO FARM LIXEIRO (ÚNICO FREE)
-- ============================================
do
    local P2 = 10
    local function getTeam()
        return LocalPlayer.Team and LocalPlayer.Team.Name or nil
    end
    local function getLevel()
        local ns = LocalPlayer:FindFirstChild("NewStats")
        local lv = ns and ns:FindFirstChild("Level")
        return lv and tonumber(lv.Value) or 0
    end
    local function getEmpregos()
        local ok, mod =
            pcall(
            function()
                return require((game:GetService("ReplicatedStorage")).Mercadinho.PrefModule)
            end
        )
        if not ok or type(mod) ~= "table" or type(mod.Empregos) ~= "table" then
            return {}
        end
        local list = {}
        for name, data in pairs(mod.Empregos) do
            table.insert(list, {nome = name, level = tonumber(data.Level) or 0, salario = tonumber(data.Salario) or 0})
        end
        table.sort(
            list,
            function(a, b2)
                if a.level == b2.level then
                    return a.nome < b2.nome
                end
                return a.level < b2.level
            end
        )
        return list
    end
    local function getLixoCount()
        local inv = LocalPlayer:FindFirstChild("Inv")
        local count = 0
        if inv then
            for _, v in ipairs(inv:GetChildren()) do
                if v.Name == "Saco de Lixo" then
                    count = count + 1
                end
            end
        end
        return count
    end
    local function getMoneySafe()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        local d = ls and ls:FindFirstChild("Dinheiro")
        return d and tonumber(d.Value) or nil
    end
    local function getLixeiroEmp()
        for _, e in ipairs(getEmpregos()) do
            if string.lower(e.nome) == "lixeiro" then
                return e
            end
        end
        return {nome = "Lixeiro", level = 1, salario = 0}
    end
    local function setFarmStatus(msg)
        o.garbageFarmStatus = tostring(msg or "")
    end
    local function isRun(runId)
        return T.autoFarmLixeiroEnabled and (not o.destroyed and o.garbageFarmRunId == runId)
    end
    local function wait2(t, runId)
        local deadline = os.clock() + math.max(0, t or 0)
        repeat
            if not isRun(runId) then
                return false
            end
            task.wait(math.min(0.1, math.max(0.01, deadline - os.clock())))
        until os.clock() >= deadline
        return isRun(runId)
    end
    local function handleIsValid()
        local char = LocalPlayer.Character
        return char, char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart")
    end
    local function sendJobSelect(remote, emp)
        remote:FireServer(emp.nome, emp.level, true)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local lx = pg and pg:FindFirstChild("LixeiroUI")
        local frame = lx and lx:FindFirstChild("LixeiroFrame")
        if frame and frame.Visible then
            frame.Visible = false
        end
    end
    local function trySelectLixeiro(runId)
        if getTeam() == "Lixeiro" then
            return true
        end
        local merc = (game:GetService("ReplicatedStorage")):FindFirstChild("Mercadinho")
        local remote = merc and merc:FindFirstChild("PrefRemote")
        if not remote or not remote:IsA("RemoteEvent") then
            setFarmStatus("PrefRemote nao encontrado")
            return false
        end
        local emp = getLixeiroEmp()
        if getLevel() < emp.level then
            return false
        end
        setFarmStatus("Selecionando lixeiro...")
        remote:FireServer(emp.nome, emp.level)
        wait2(0.25, runId)
        if not isRun(runId) then
            return false
        end
        sendJobSelect(remote, emp)
        local deadline = os.clock() + P2
        repeat
            if not isRun(runId) then
                return false
            end
            if getTeam() == "Lixeiro" then
                wait2(1.2, runId)
                return true
            end
            task.wait(0.15)
        until os.clock() >= deadline
        return false
    end
    local function isLixoPart(part, prompt)
        return part and part.Parent and part:IsA("BasePart") and part.Name == "Lixo" and part.Transparency < 0.95 and
            (prompt and prompt.Parent == part and prompt:IsA("ProximityPrompt") and prompt.Enabled)
    end
    local function scanLixos()
        local char, hum, root = handleIsValid()
        local folder = workspace:FindFirstChild("Lixeiro")
        local list = {}
        if not root or not folder then
            return list
        end
        for _, part in ipairs(folder:GetChildren()) do
            local prompt = part:FindFirstChild("PegarLixo")
            if isLixoPart(part, prompt) then
                table.insert(
                    list,
                    {
                        parte = part,
                        prompt = prompt,
                        posicao = part.Position,
                        distancia = (part.Position - root.Position).Magnitude
                    }
                )
            end
        end
        table.sort(
            list,
            function(a, b3)
                return a.distancia < b3.distancia
            end
        )
        return list
    end
    local function inRange(root, part, prompt)
        if not root or not part or not part.Parent then
            return false
        end
        local maxD = prompt and math.max(2.5, prompt.MaxActivationDistance - 0.65) or 4.25
        return (root.Position - part.Position).Magnitude <= maxD
    end
    local function walkTo(part, prompt, runId)
        local char, hum, root = handleIsValid()
        if not char or not hum or not root or hum.Health <= 0 then
            return false
        end
        if inRange(root, part, prompt) then
            return true
        end
        for attempt = 1, 4, 1 do
            if not isRun(runId) or not part.Parent then
                return false
            end
            char, hum, root = handleIsValid()
            if not char or not hum or not root or hum.Health <= 0 then
                return false
            end
            if inRange(root, part, prompt) then
                return true
            end
            local maxD = prompt and math.max(2.5, prompt.MaxActivationDistance - 0.8) or 4
            local flat = Vector3.new(root.Position.X - part.Position.X, 0, root.Position.Z - part.Position.Z)
            local dir = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
            local radius = math.max(part.Size.X, part.Size.Z) * 0.5
            local safe = math.clamp(radius + 1.25, 1.25, math.max(1.25, maxD - 0.35))
            local goal = part.Position + dir * safe
            local path =
                PathfindingService:CreatePath(
                {
                    AgentRadius = 2,
                    AgentHeight = 5,
                    AgentCanJump = true,
                    AgentCanClimb = true,
                    WaypointSpacing = 5
                }
            )
            local ok =
                pcall(
                function()
                    path:ComputeAsync(root.Position, goal)
                end
            )
            local waypoints =
                ok and (path.Status == Enum.PathStatus.Success and path:GetWaypoints()) or
                {{Position = goal, Action = Enum.PathWaypointAction.Walk}}
            local idx = 0
            local blocked = false
            local blockConn =
                path.Blocked:Connect(
                function(wp)
                    if wp <= idx + 1 then
                        blocked = true
                    end
                end
            )
            for i, wp in ipairs(waypoints) do
                idx = i
                if not isRun(runId) or blocked then
                    break
                end
                char, hum, root = handleIsValid()
                if not char or not hum or not root or hum.Health <= 0 then
                    break
                end
                if inRange(root, part, prompt) then
                    blockConn:Disconnect()
                    return true
                end
                if wp.Action == Enum.PathWaypointAction.Jump then
                    hum.Jump = true
                    pcall(
                        function()
                            hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                    )
                end
                hum:MoveTo(wp.Position)
                local last = root.Position
                local lastMove = os.clock()
                local lastJump = 0
                local deadline = os.clock() + 8
                repeat
                    RunService.Heartbeat:Wait()
                    if not isRun(runId) then
                        blockConn:Disconnect()
                        return false
                    end
                    char, hum, root = handleIsValid()
                    if not char or not hum or not root then
                        break
                    end
                    if inRange(root, part, prompt) then
                        blockConn:Disconnect()
                        return true
                    end
                    local now = os.clock()
                    if (root.Position - last).Magnitude >= 0.8 then
                        last = root.Position
                        lastMove = now
                    elseif now - lastMove >= 1.25 and now - lastJump >= 1 then
                        lastJump = now
                        hum.Jump = true
                        pcall(
                            function()
                                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                            end
                        )
                        hum:MoveTo(wp.Position)
                    end
                    if now - lastMove >= 3 then
                        blocked = true
                    end
                until blocked or os.clock() >= deadline or (root.Position - wp.Position).Magnitude <= 3
            end
            blockConn:Disconnect()
            char, hum, root = handleIsValid()
            if root and inRange(root, part, prompt) then
                return true
            end
            wait2(0.2, runId)
        end
        return false
    end
    local function firePrompt(prompt, force)
        if not prompt or not prompt.Parent or not prompt.Enabled then
            return false
        end
        if not force and type(fireproximityprompt) == "function" then
            return pcall(fireproximityprompt, prompt, 0)
        end
        return pcall(
            function()
                prompt:InputHoldBegin()
                task.wait(math.max(0.15, prompt.HoldDuration + 0.1))
                prompt:InputHoldEnd()
            end
        )
    end
    local function collectOne(part, prompt, runId)
        local before = getLixoCount()
        for attempt = 1, 3, 1 do
            if not isRun(runId) or not isLixoPart(part, prompt) then
                return not part.Parent or part.Transparency >= 0.95
            end
            local _, _, root = handleIsValid()
            if not inRange(root, part, prompt) then
                return false
            end
            firePrompt(prompt, attempt > 1)
            local deadline = os.clock() + 2.75
            repeat
                if not isRun(runId) then
                    return false
                end
                if not part.Parent or part.Transparency >= 0.95 or getLixoCount() > before then
                    return true
                end
                task.wait(0.1)
            until os.clock() >= deadline
        end
        return false
    end
    local function findDelivery()
        local folder = workspace:FindFirstChild("EntregaLixo")
        local lixeira = folder and folder:FindFirstChild("Lixeira")
        local prompt = lixeira and lixeira:FindFirstChild("EntregarLixo")
        if lixeira and lixeira:IsA("BasePart") and prompt and prompt:IsA("ProximityPrompt") then
            return lixeira, prompt
        end
        return nil, nil
    end
    local function deliverLixos(count, runId)
        local part, prompt = findDelivery()
        if not part or not prompt then
            return false
        end
        setFarmStatus(string.format("%d/%d coletados; indo entregar...", count, count))
        if not walkTo(part, prompt, runId) then
            if not isRun(runId) then
                return false
            end
            return false
        end
        local beforeCount = getLixoCount()
        local beforeMoney = getMoneySafe()
        for attempt = 1, 3, 1 do
            if not isRun(runId) then
                return false
            end
            firePrompt(prompt, attempt > 1)
            local deadline = os.clock() + 4
            repeat
                if not isRun(runId) then
                    return false
                end
                local nowCount = getLixoCount()
                local nowMoney = getMoneySafe()
                if (beforeCount > 0 and nowCount < beforeCount) or (beforeMoney and nowMoney and nowMoney > beforeMoney) then
                    return true
                end
                task.wait(0.15)
            until os.clock() >= deadline
        end
        return false
    end
    local function farmLoop(runId)
        while isRun(runId) do
            if not trySelectLixeiro(runId) then
                wait2(2, runId)
            else
                local goal = math.clamp(math.floor(tonumber(T.autoFarmLixeiroQuantidade) or 20), 1, 20)
                local collected = 0
                while isRun(runId) and (getTeam() == "Lixeiro" and collected < goal) do
                    local list = scanLixos()
                    if #list == 0 then
                        setFarmStatus(string.format("Coletados %d/%d; aguardando...", collected, goal))
                        wait2(1.25, runId)
                    else
                        local target = list[1]
                        if walkTo(target.parte, target.prompt, runId) then
                            if collectOne(target.parte, target.prompt, runId) then
                                collected = collected + 1
                                wait2(0.45, runId)
                            else
                                if not isRun(runId) then
                                    break
                                end
                                wait2(0.35, runId)
                            end
                        else
                            if not isRun(runId) then
                                break
                            end
                            wait2(0.4, runId)
                        end
                    end
                end
                if not isRun(runId) then
                    break
                end
                if getTeam() ~= "Lixeiro" then
                    setFarmStatus("Emprego alterado; retomando...")
                elseif collected >= goal then
                    while isRun(runId) and not deliverLixos(collected, runId) do
                        wait2(1, runId)
                    end
                    if isRun(runId) then
                        wait2(1.25, runId)
                    end
                end
            end
        end
    end
    local function startLixeiro(enable)
        T.autoFarmLixeiroEnabled = enable == true
        o.garbageFarmRunId = o.garbageFarmRunId + 1
        local runId = o.garbageFarmRunId
        if T.autoFarmLixeiroEnabled then
            setFarmStatus("Verificando emprego...")
            task.spawn(
                function()
                    local ok, err = pcall(farmLoop, runId)
                    if not ok and isRun(runId) then
                        setFarmStatus("Erro: " .. tostring(err))
                        T.autoFarmLixeiroEnabled = false
                        o.garbageFarmRunId = o.garbageFarmRunId + 1
                    end
                end
            )
        else
            setFarmStatus("Auto Farm parado.")
            local char, hum, root = handleIsValid()
            if hum and root then
                hum:MoveTo(root.Position)
            end
        end
    end
    o.startLixeiro = startLixeiro
end

