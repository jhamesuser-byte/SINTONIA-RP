do
    local function applyWorld()
        local L = game:GetService("Lighting")
        local active = T.alwaysDay or T.fullbright or T.noShadow or T.noFog or T.noBlur
        if not o.worldOriginal and active then
            o.worldOriginal = {
                Brightness = L.Brightness,
                ClockTime = L.ClockTime,
                FogEnd = L.FogEnd,
                FogStart = L.FogStart,
                GlobalShadows = L.GlobalShadows,
                Ambient = L.Ambient,
                OutdoorAmbient = L.OutdoorAmbient,
                ExposureCompensation = L.ExposureCompensation
            }
        end
        local orig = o.worldOriginal
        if not active then
            if orig then
                for k, v in pairs(orig) do
                    pcall(
                        function()
                            L[k] = v
                        end
                    )
                end
            end
            return
        end
        if T.alwaysDay or T.fullbright then
            L.ClockTime = 14
        elseif orig then
            L.ClockTime = orig.ClockTime
        end
        if T.fullbright then
            L.Brightness = 2
            L.ExposureCompensation = 0
            L.Ambient = Color3.new(1, 1, 1)
            L.OutdoorAmbient = Color3.new(1, 1, 1)
        elseif orig then
            L.Brightness = orig.Brightness
            L.ExposureCompensation = orig.ExposureCompensation
            L.Ambient = orig.Ambient
            L.OutdoorAmbient = orig.OutdoorAmbient
        end
        if T.noShadow or T.fullbright then
            L.GlobalShadows = false
        elseif orig then
            L.GlobalShadows = orig.GlobalShadows
        end
        if T.noFog or T.fullbright then
            L.FogStart = 0
            L.FogEnd = 1000000000
            local atm = L:FindFirstChildOfClass("Atmosphere")
            if atm then
                atm.Density = 0
            end
        elseif orig then
            L.FogStart = orig.FogStart
            L.FogEnd = orig.FogEnd
        end
        if T.noBlur then
            for _, v in ipairs(L:GetDescendants()) do
                if v:IsA("BlurEffect") then
                    v.Enabled = false
                end
            end
        end
    end
    o.applyWorld = applyWorld
    local acc = 0
    handleReady(
        RunService.Heartbeat:Connect(
            function(dt)
                if T.alwaysDay or T.fullbright then
                    pcall(
                        function()
                            (game:GetService("Lighting")).ClockTime = 14
                        end
                    )
                end
                acc = acc + dt
                if acc < 0.25 then
                    return
                end
                acc = 0
                if T.alwaysDay or T.fullbright or T.noShadow or T.noFog or T.noBlur then
                    pcall(applyWorld)
                end
            end
        )
    )
end

